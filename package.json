    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^22.12.0",
    "@types/papaparse": "^5.5.2",
    "axe-core": "4.14.0",
    "jsdom": "^31.0.1",
    "lighthouse": "13.6.0",
    "playwright-core": "1.59",
