    "@zxcvbn-ts/language-en": "4.1.1",
    "@zxcvbn-ts/language-it": "4.1.1",
    "asn1js": "4.0.0",
    "bcryptjs": "3.0.3",
    "cronstrue": "3.38.0",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "jsbarcode": "3.12.3",
    "jspdf": "^4.2.1",
    "jsqr": "1.4.0",
