{
  "name": "rrstudio-tools",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/build-sw.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch && node --test scripts/*.test.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "e2e": "node scripts/screenshots.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "og-images": "node scripts/og-images.mjs",
    "pwa-icons": "node scripts/pwa-icons.mjs",
    "pwa-check": "node scripts/pwa-check.mjs",
    "i18n-check": "node scripts/i18n-check.mjs",
    "licenses": "node scripts/third-party-licenses.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "cloudflare:prepare": "node scripts/cloudflare-pages.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
